<Application x:Class="NightShift.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NightShift.App" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="HoverSurface" Color="#223A48"/>
    <SolidColorBrush x:Key="PressedSurface" Color="#2B4858"/>
    <SolidColorBrush x:Key="ActionHover" Color="#3E718A"/>
    <SolidColorBrush x:Key="ActionPressed" Color="#295168"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0D1922"/>
    <SolidColorBrush x:Key="SidebarSurface" Color="#152632"/>
    <SolidColorBrush x:Key="SidebarLine" Color="#263A47"/>
    <SolidColorBrush x:Key="SidebarInk" Color="#E4EEF3"/>
    <SolidColorBrush x:Key="SidebarMuted" Color="#99AFBD"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#223C4C"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1C3240"/>
    <SolidColorBrush x:Key="SidebarPressed" Color="#2B4656"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#B6DEE9"/>
    <SolidColorBrush x:Key="Bg" Color="#111F2B"/>
    <SolidColorBrush x:Key="Surface" Color="#192C3A"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#142431"/>
    <SolidColorBrush x:Key="Line" Color="#304755"/>
    <SolidColorBrush x:Key="Ink" Color="#ECF3F7"/>
    <SolidColorBrush x:Key="Muted" Color="#A6BAC7"/>
    <SolidColorBrush x:Key="Purple" Color="#AAD6E6"/>
    <SolidColorBrush x:Key="Mint" Color="#9FD6D6"/>
    <SolidColorBrush x:Key="Action" Color="#305F77"/>
    <SolidColorBrush x:Key="UserSurface" Color="#1C3342"/>
    <SolidColorBrush x:Key="NoticeSurface" Color="#343128"/>
    <SolidColorBrush x:Key="NoticeInk" Color="#F1D49B"/>
    <SolidColorBrush x:Key="CodeInk" Color="#C0DEED"/>
    <SolidColorBrush x:Key="Selection" Color="#365B70"/>
    <SolidColorBrush x:Key="StatusSurface" Color="#19363E"/>
    <SolidColorBrush x:Key="Disabled" Color="#20323F"/>
    <SolidColorBrush x:Key="BrandInk" Color="#C0E2ED"/>
    <SolidColorBrush x:Key="AvatarSurface" Color="#234152"/>
    <DrawingImage x:Key="BrandMark">
      <DrawingImage.Drawing><DrawingGroup>
        <DrawingGroup.OpacityMask><ImageBrush ImageSource="pack://application:,,,/NightShift;component/Assets/night-shift.png" Stretch="Uniform"/></DrawingGroup.OpacityMask>
        <GeometryDrawing Brush="{DynamicResource BrandInk}" Geometry="M0,0 H1280 V1280 H0 Z"/>
      </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="ProviderSegment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,8"/><Setter Property="MinWidth" Value="104"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid><Border x:Name="Segment" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <Border x:Name="FocusRing" Margin="2" CornerRadius="5" BorderBrush="{DynamicResource Ink}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource PressedSurface}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource UserSurface}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Purple}"/><Setter Property="Foreground" Value="{DynamicResource Purple}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ThemeButton" TargetType="CheckBox">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="ThemeBox" Background="Transparent" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1">
          <Viewbox Width="17" Height="17"><Path x:Name="ThemeGlyph" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,5 A7,7 0 1 0 19,12 A6,6 0 0 1 12,5 Z"/></Viewbox>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="ThemeGlyph" Property="Data" Value="M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 M12,1 V3 M12,21 V23 M1,12 H3 M21,12 H23 M4,4 L5.5,5.5 M18.5,18.5 L20,20 M20,4 L18.5,5.5 M5.5,18.5 L4,20"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThemeBox" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ThemeBox" Property="BorderBrush" Value="{DynamicResource Purple}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="NewConversationLabel">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Canvas Width="26" Height="26"><Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1"/></Canvas></Viewbox>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ConnectionLabel">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Canvas Width="26" Height="26"><Path Data="M10,14 L14,10 M8,15 L6,17 A4,4 0 0 1 1,12 L6,7 A4,4 0 0 1 11,7 M13,17 A4,4 0 0 0 18,17 L23,12 A4,4 0 0 0 18,7 L16,9" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1"/></Canvas></Viewbox>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ActivityLabel">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Canvas Width="26" Height="26"><Path Data="M3,17 V11 M9,17 V5 M15,17 V8 M21,17 V2 M2,22 H22" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1"/></Canvas></Viewbox>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="SettingsLabel">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Canvas Width="26" Height="26"><Path Data="M4,6 H20 M4,12 H20 M4,18 H20 M8,3 V9 M16,9 V15 M10,15 V21" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1"/></Canvas></Viewbox>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="AttachmentLabel">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Canvas Width="26" Height="26"><Path Data="M8,13 L15,6 A3,3 0 0 1 19,10 L10,19 A5,5 0 0 1 3,12 L13,2" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1"/></Canvas></Viewbox>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LimitsLabel">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"><Canvas Width="26" Height="26"><Path Data="M3,12 A9,9 0 0 1 21,12 M3,12 V18 H21 V12 M12,14 L17,8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1"/></Canvas></Viewbox>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
    <BooleanToVisibilityConverter x:Key="VisibleIf"/>
    <Style x:Key="AppWindow" TargetType="Window"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,18,0,8"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="Button"><Setter Property="local:ButtonFeedback.HoverBrush" Value="{DynamicResource HoverSurface}"/><Setter Property="local:ButtonFeedback.PressedBrush" Value="{DynamicResource PressedSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Mint}" BorderThickness="2" CornerRadius="8" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(local:ButtonFeedback.HoverBrush)}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Purple}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(local:ButtonFeedback.PressedBrush)}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Purple}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="1"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource Disabled}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="local:ButtonFeedback.HoverBrush" Value="{DynamicResource ActionHover}"/><Setter Property="local:ButtonFeedback.PressedBrush" Value="{DynamicResource ActionPressed}"/><Setter Property="Background" Value="{DynamicResource Action}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Action}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,4"/><Setter Property="FontSize" Value="15"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Mint}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="15"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Purple}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="36,0,10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="SearchBox" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
          <Grid>
            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Data="M16,10 A6,6 0 1 0 4,10 A6,6 0 1 0 16,10 M14.5,14.5 L21,21" Stroke="{DynamicResource SidebarMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round"/></Canvas></Viewbox>
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchBox" Property="BorderBrush" Value="{DynamicResource SidebarAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource SidebarMuted}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,12,0,8"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="12,9"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="15"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"><TextBlock Text="⌄" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,10,32,10" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="Background" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Purple}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="8,0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource Line}" BorderBrush="{DynamicResource Muted}" BorderThickness="1">
          <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Action}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Action}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Mint}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="local:ButtonFeedback.HoverBrush" Value="{DynamicResource SidebarHover}"/><Setter Property="local:ButtonFeedback.PressedBrush" Value="{DynamicResource SidebarPressed}"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="BeforeThumb" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="20" MinWidth="8"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" Opacity="0.5" CornerRadius="4" Margin="3,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="AfterThumb" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Grid>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollThumb" Property="MinHeight" Value="8"/><Setter TargetName="ScrollThumb" Property="MinWidth" Value="20"/><Setter TargetName="BeforeThumb" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="AfterThumb" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
