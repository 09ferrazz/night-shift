<Window x:Class="NightShift.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NightShift.App"
 Style="{StaticResource AppWindow}" Title="Night Shift · 0.7.0" Width="1280" Height="820" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
 Icon="Assets/night-shift.ico" Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowPreviewKeyDown" SizeChanged="WindowSizeChanged">
 <Window.Resources><local:AttachmentThumbnail x:Key="AttachmentThumbnail"/>
  <DataTemplate x:Key="ChatTemplate">
   <Grid Margin="0,8,0,28">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource AvatarSurface}" Width="30" Height="30" CornerRadius="10" VerticalAlignment="Top"><Grid><Image x:Name="AgentMark" Source="{DynamicResource BrandMark}" Width="26" Height="26"/><TextBlock x:Name="RoleLetter" Visibility="Collapsed" Text="{Binding RoleInitial}" Foreground="{DynamicResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/></Grid></Border>
    <StackPanel Grid.Column="1">
     <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Copiar" Click="CopyMessageClick" Tag="{Binding CopyText}" Style="{StaticResource Quiet}" Padding="8,2" FontSize="12" AutomationProperties.Name="Copiar mensagem completa"/><TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" Style="{StaticResource Caption}" Margin="8,2"/><TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="14"/></DockPanel>
     <Border x:Name="MessageSurface" CornerRadius="12" Padding="0" Background="Transparent">
      <StackPanel><local:MessageBody Text="{Binding Text,Mode=OneWay}"/><Border Visibility="{Binding HasAttachments,Converter={StaticResource VisibleIf}}" Margin="0,8,0,0" Padding="9,7" CornerRadius="6" Background="{DynamicResource SurfaceAlt}"><TextBlock Text="{Binding AttachmentSummary}" TextWrapping="Wrap" FontSize="13"/></Border></StackPanel>
     </Border>
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Role}" Value="Você"><Setter TargetName="MessageSurface" Property="Background" Value="{DynamicResource UserSurface}"/><Setter TargetName="MessageSurface" Property="Padding" Value="14,12"/><Setter TargetName="AgentMark" Property="Visibility" Value="Collapsed"/><Setter TargetName="RoleLetter" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="RootLayout" SizeChanged="RootLayoutSizeChanged">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="NavigationPanel" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,0,1,0" Width="250" HorizontalAlignment="Left" Panel.ZIndex="10">
   <Grid Margin="16,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
     <Button DockPanel.Dock="Right" Content="‹" Click="MenuClick" Style="{DynamicResource SidebarButton}" Padding="8,4" FontSize="22" AutomationProperties.Name="Recolher conversas"/>
     <Button x:Name="SessionNav" Click="NavClick" Tag="Session" Style="{DynamicResource SidebarButton}" Padding="0,4" FontWeight="SemiBold" AutomationProperties.Name="Night Shift — voltar à conversa">
      <StackPanel Orientation="Horizontal"><Image Source="{DynamicResource BrandMark}" Width="38" Height="38" Margin="0,0,10,0"/><TextBlock Text="Night Shift" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource SidebarInk}"/></StackPanel>
     </Button>
    </DockPanel>
    <Button Grid.Row="1" Content="Nova conversa" ContentTemplate="{StaticResource NewConversationLabel}" Click="NewClick" IsEnabled="{Binding CanUseShortcuts}" Background="{DynamicResource SidebarSelected}" Foreground="{DynamicResource SidebarAccent}" BorderBrush="Transparent" local:ButtonFeedback.HoverBrush="{DynamicResource SidebarHover}" local:ButtonFeedback.PressedBrush="{DynamicResource SidebarPressed}" Margin="0,0,0,12"/>
     <Grid Grid.Row="2"><TextBox x:Name="SidebarSearch" Style="{StaticResource SidebarSearchBox}" TextChanged="SidebarSearchChanged" Background="{DynamicResource SidebarSurface}" Foreground="{DynamicResource SidebarInk}" BorderBrush="{DynamicResource SidebarLine}" CaretBrush="{DynamicResource SidebarInk}" FontSize="13" ToolTip="Buscar entre as conversas carregadas" AutomationProperties.Name="Buscar conversas recentes" Padding="36,0,10,0" Height="40"/>
     <TextBlock Text="Buscar conversas" Foreground="{DynamicResource SidebarMuted}" FontSize="13" Margin="37,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SidebarSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
     <DockPanel Grid.Row="3" Margin="2,14,0,6"><Button DockPanel.Dock="Right" Content="Ver todas" Click="HistoryClick" Style="{DynamicResource SidebarButton}" Padding="5,4" FontSize="12"/><TextBlock Text="{Binding SidebarSectionLabel}" Foreground="{DynamicResource SidebarMuted}" FontSize="13" VerticalAlignment="Center"/></DockPanel>
    <ListBox Grid.Row="4" x:Name="RecentList" SelectedValuePath="ThreadId" SelectedValue="{Binding CurrentThreadId,Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Conversas recentes">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBox" CornerRadius="7" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBox" Property="Background" Value="{DynamicResource SidebarSelected}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBox" Property="BorderBrush" Value="{DynamicResource SidebarAccent}"/><Setter TargetName="ItemBox" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Button Click="ResumeClick" Tag="{Binding}" Style="{DynamicResource SidebarButton}" IsEnabled="{Binding DataContext.CanOpenRecent,RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding ProjectPath}"><TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource SidebarInk}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" FontSize="14"/></Button></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="RecentEmpty" Grid.Row="4" Visibility="Collapsed" Text="Conecte para carregar conversas" Foreground="{DynamicResource SidebarMuted}" TextWrapping="Wrap" Margin="8,9,8,0" FontSize="12" IsHitTestVisible="False"/>
     <StackPanel Grid.Row="5"><Border BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,1,0,0" Margin="0,14,0,9"/>
      <Button Content="Conexão" ContentTemplate="{StaticResource ConnectionLabel}" Style="{DynamicResource SidebarButton}" Click="NavClick" Tag="Integrations" Margin="0,0,0,4"/>
      <Button Content="Atividade e limites" ContentTemplate="{StaticResource ActivityLabel}" Style="{DynamicResource SidebarButton}" Click="NavClick" Tag="Activity" Margin="0,0,0,8"/>
      <Button Content="Ajustes" ContentTemplate="{StaticResource SettingsLabel}" Style="{DynamicResource SidebarButton}" Click="NavClick" Tag="Settings"/>
     </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
    <StackPanel><Grid x:Name="ContextBar" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="OpenSidebar" Style="{StaticResource Quiet}" Click="MenuClick" Width="34" Height="36" Padding="9" AutomationProperties.Name="Mostrar ou recolher conversas"><Path Data="M1,2 H16 M1,8 H16 M1,14 H16" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
     <Button Grid.Column="1" x:Name="BackButton" Content="←" Style="{StaticResource Quiet}" Click="BackClick" Visibility="Collapsed" Width="32" Height="36" Padding="4" AutomationProperties.Name="Voltar à página anterior" ToolTip="Voltar à página anterior"/>
     <Button Grid.Column="2" x:Name="ProjectButton" Click="BrowseProjectClick" IsEnabled="{Binding CanChangeProject}" HorizontalContentAlignment="Left" Style="{StaticResource Quiet}" Padding="10,4" Margin="4,0,12,0" ToolTip="{Binding ProjectPath}" AutomationProperties.Name="Escolher projeto">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding PlatformLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></Grid>
     </Button>
     <Button Grid.Column="3" Content="{Binding HeaderConnectionLabel}" Click="HeaderConnectionClick" Background="{DynamicResource StatusSurface}" Foreground="{DynamicResource Mint}" BorderThickness="0" Padding="12,8" Margin="0,0,10,0" FontSize="12" ToolTip="Conectar ou ver detalhes da conexão"/>
     <CheckBox Grid.Column="4" x:Name="ThemeToggle" Style="{StaticResource ThemeButton}" IsChecked="{Binding IsDarkTheme,Mode=TwoWay}" AutomationProperties.Name="Tema escuro" ToolTip="Alternar tema claro e escuro" VerticalAlignment="Center"/>
     <Button Grid.Column="5" x:Name="ActionsButton" Content="···" Click="ActionsClick" Style="{StaticResource Quiet}" Width="36" Height="36" Padding="4" FontSize="22" Margin="4,0,0,0" AutomationProperties.Name="Ações da conversa" ToolTip="Ações da conversa · Ctrl+K"/>
    </Grid>
    <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="☾ Slim" Click="SlimClick" Style="{StaticResource Quiet}" Padding="12,5" AutomationProperties.Name="Abrir gatinho flutuante"/>
     <UniformGrid Columns="2" Width="216" HorizontalAlignment="Left" IsEnabled="{Binding CanSwitchProvider}" ToolTip="{Binding ProviderSwitchHint}" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
      <RadioButton Content="Codex" GroupName="Provider" Tag="Codex" IsChecked="{Binding IsCodexProvider,Mode=OneWay}" Checked="ProviderChecked" Style="{StaticResource ProviderSegment}" Margin="0,0,4,0" AutomationProperties.Name="Codex"/>
      <RadioButton Content="Claude" GroupName="Provider" Tag="Claude" IsChecked="{Binding IsClaudeProvider,Mode=OneWay}" Checked="ProviderChecked" Style="{StaticResource ProviderSegment}" Margin="4,0,0,0" AutomationProperties.Name="Claude"/>
     </UniformGrid>
    </DockPanel></StackPanel>
   </Border>
   <Border Grid.Row="1" Background="{DynamicResource NoticeSurface}" CornerRadius="8" Padding="12,8" Margin="24,10,24,0" Visibility="{Binding HasNotice,Converter={StaticResource VisibleIf}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource Quiet}" Padding="10,0" Click="DismissClick" AutomationProperties.Name="Dispensar aviso"/><ScrollViewer x:Name="NoticeScroll" MaxHeight="80" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeInk}" FontSize="13"/></ScrollViewer></DockPanel>
   </Border>
   <Grid Grid.Row="2" x:Name="PageHost" Margin="28,18,28,14">
    <Grid x:Name="SessionPage" MaxWidth="880">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Margin="0,2,0,18" Text="{Binding ConversationTitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConversationTitle}"/>
     <Button Grid.Row="1" Content="{Binding EarlierMessagesLabel}" Visibility="{Binding HasEarlierMessages,Converter={StaticResource VisibleIf}}" Click="EarlierMessagesClick" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Padding="10,5"/>
     <Grid Grid.Row="2">
      <ListBox x:Name="ChatList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatTemplate}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="ChatScrollChanged" PreviewMouseWheel="ChatMouseWheel" PreviewKeyDown="ChatKeyDown" AutomationProperties.Name="Conversa"/>
      <ScrollViewer Visibility="{Binding IsChatEmpty,Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="12"><Image x:Name="EmptyLogo" Source="{DynamicResource BrandMark}" Width="112" Height="112" Margin="0,0,0,20"/><TextBlock Text="O que vamos criar hoje?" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{Binding EmptyConversationHint}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer>
      <Button x:Name="JumpToEnd" Content="↓  Ir para o fim" Click="JumpToEndClick" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8" Padding="12,8" AutomationProperties.Name="Ir para o fim da conversa"/>
     </Grid>
     <ScrollViewer x:Name="RequestNotices" Grid.Row="3" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Visibility="{Binding HasQuotaNotice,Converter={StaticResource VisibleIf}}" Background="{DynamicResource NoticeSurface}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Continuar tarefa" Click="ContinueClick" Padding="10,6" Margin="10,0,0,0" Visibility="{Binding CanConfirmContinuation,Converter={StaticResource VisibleIf}}"/><Button DockPanel.Dock="Right" Content="Detalhes" Style="{StaticResource Quiet}" Tag="Activity" Click="NavClick" Padding="8,3"/><TextBlock Text="{Binding QuotaNotice}" Foreground="{DynamicResource NoticeInk}" TextWrapping="Wrap" FontSize="13"/></DockPanel></Border>
      <Border Visibility="{Binding HasPending,Converter={StaticResource VisibleIf}}" Background="{DynamicResource NoticeSurface}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Responder" Click="PendingClick" Padding="10,6" Margin="10,0,0,0"/><TextBlock Text="{Binding PendingLabel}" Foreground="{DynamicResource NoticeInk}" TextWrapping="Wrap" FontSize="13"/></DockPanel></Border>
      <Border Visibility="{Binding IsReadOnlySession,Converter={StaticResource VisibleIf}}" Background="{DynamicResource NoticeSurface}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Abrir origem" Click="OpenOriginClick" IsEnabled="{Binding CanOpenOrigin}" Padding="10,6"/><TextBlock Text="{Binding ReadOnlyHint}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeInk}" FontSize="13"/></DockPanel></Border>
      <Border Visibility="{Binding HasOriginRequest,Converter={StaticResource VisibleIf}}" Background="{DynamicResource NoticeSurface}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0"><TextBlock Text="Há uma solicitação no aplicativo de origem. Responda por lá." TextWrapping="Wrap" Foreground="{DynamicResource NoticeInk}" FontSize="13"/></Border>
     </StackPanel></ScrollViewer>
     <DockPanel Grid.Row="4" Margin="0,8,0,8"><Button x:Name="LimitsButton" DockPanel.Dock="Right" Content="Limites de uso" ContentTemplate="{StaticResource LimitsLabel}" Click="LimitsClick" Style="{StaticResource Quiet}" Padding="8,2" FontSize="12" ToolTip="Uso de 5 horas e semanal" AutomationProperties.Name="Abrir limites de uso"/><TextBlock Text="●" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Mint}"/></DataTrigger><DataTrigger Binding="{Binding HasPending}" Value="True"><Setter Property="Foreground" Value="{DynamicResource NoticeInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></DockPanel>
     <Border x:Name="ComposerSurface" AllowDrop="True" PreviewDragOver="AttachmentDragOver" PreviewDrop="AttachmentDrop" Grid.Row="5" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="16,12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="AttachmentStrip" Visibility="{Binding HasAttachments,Converter={StaticResource VisibleIf}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="62" Margin="0,0,0,6">
        <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,7,0" ToolTip="{Binding Help}"><DockPanel>
          <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="RemoveAttachmentClick" Style="{StaticResource Quiet}" Width="24" Height="26" Padding="0" Margin="6,0,0,0" ToolTip="Remover anexo" AutomationProperties.Name="{Binding Name,StringFormat=Remover {0}}"/>
          <Grid Width="34" Height="34" Margin="0,0,7,0"><TextBlock Text="▧" Foreground="{DynamicResource Purple}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Converter={StaticResource AttachmentThumbnail}}" Stretch="UniformToFill"/></Grid>
          <StackPanel Width="130" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10"/></StackPanel>
         </DockPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
       <Grid Grid.Row="1"><TextBox x:Name="Composer" Text="{Binding Draft,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="2" KeyDown="ComposerKeyDown" MaxLength="50000" IsEnabled="{Binding CanCompose}" AutomationProperties.Name="{Binding ComposerAccessibleName}" ToolTip="Ctrl+Enter para enviar. Enter cria uma linha."/>
        <TextBlock Text="O que você quer fazer neste projeto?" Foreground="{DynamicResource Muted}" Margin="3,4" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <DockPanel Grid.Row="2" Margin="0,6,0,0"><Button x:Name="PrimaryAction" DockPanel.Dock="Right" Content="{Binding PrimaryActionLabel}" IsEnabled="{Binding CanPrimaryAction}" Click="PrimaryActionClick" Style="{StaticResource Primary}" Padding="22,9" MinWidth="96"/><Button x:Name="ComposerStop" DockPanel.Dock="Right" Content="Parar" Click="StopClick" IsEnabled="{Binding CanStop}" Visibility="{Binding ShowStopAction,Converter={StaticResource VisibleIf}}" Style="{StaticResource Quiet}" Padding="10,7" Margin="0,0,8,0" ToolTip="Interromper o trabalho atual" AutomationProperties.Name="Parar turno"/><Button x:Name="AttachButton" DockPanel.Dock="Left" Content="Anexar" ContentTemplate="{StaticResource AttachmentLabel}" Click="AttachClick" IsEnabled="{Binding CanAttach}" Style="{StaticResource Quiet}" Padding="10,7" Margin="0,0,10,0" FontSize="12" ToolTip="Imagens e arquivos · até 10 anexos de 25 MB. Também pode arrastar ou colar."/><TextBlock Text="{Binding DraftDeliveryHint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DraftDeliveryHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" FontSize="11"/></DockPanel>
      </Grid>
     </Border>
     <DockPanel Grid.Row="6" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Configurar turno" Click="NavClick" Tag="Settings" Style="{StaticResource Quiet}" Padding="4,2" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="☾" FontSize="17" Foreground="{DynamicResource Purple}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Turno noturno" Style="{StaticResource Caption}" VerticalAlignment="Center"/><CheckBox x:Name="NightToggle" Style="{StaticResource Switch}" IsChecked="{Binding NightShiftEnabled,Mode=OneWay}" IsEnabled="{Binding CanSetNightShift}" Click="NightToggleClick" AutomationProperties.Name="Turno noturno" ToolTip="Ative antes de enviar para acompanhar limites. Desativar um turno ativo também interrompe seu trabalho."/><TextBlock Text="{Binding NightShiftDetail}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel></DockPanel>
     <Border x:Name="QuotaPanel" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="5" Visibility="Collapsed" Width="304" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,36" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" AutomationProperties.Name="Limites de uso">
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
      <StackPanel>
       <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="×" Click="CloseLimitsClick" Style="{StaticResource Quiet}" Padding="6,0" AutomationProperties.Name="Fechar limites" ToolTip="Fechar · Esc"/><TextBlock Text="Seus limites" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding FiveHourUsage}" Style="{StaticResource Caption}"/><TextBlock Text="5 horas" FontSize="13" FontWeight="SemiBold"/></DockPanel>
       <ProgressBar Value="{Binding FiveHourUsed,Mode=OneWay}" Maximum="100" Visibility="{Binding HasFiveHourLimit,Converter={StaticResource VisibleIf}}" Margin="0,7,0,5" AutomationProperties.Name="Uso da janela de 5 horas"/>
       <TextBlock Text="{Binding FiveHourReset}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,14"/>
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding WeeklyUsage}" Style="{StaticResource Caption}"/><TextBlock Text="Semanal" FontSize="13" FontWeight="SemiBold"/></DockPanel>
       <ProgressBar Value="{Binding WeeklyUsed,Mode=OneWay}" Maximum="100" Foreground="{DynamicResource Mint}" Visibility="{Binding HasWeeklyLimit,Converter={StaticResource VisibleIf}}" Margin="0,7,0,5" AutomationProperties.Name="Uso da janela semanal"/>
       <TextBlock Text="{Binding WeeklyReset}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,12"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="↻" Click="RefreshLimitsClick" IsEnabled="{Binding CanRefreshLimits}" Style="{StaticResource Quiet}" Padding="5,0" ToolTip="Consultar limites informados pela IA ativa" AutomationProperties.Name="Atualizar limites"/><TextBlock Text="{Binding LimitsUpdateLabel}" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
     </Border>
    </Grid>

    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left">
     <TextBlock Text="Ajustes" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Preferências do projeto e do turno noturno." Foreground="{DynamicResource Muted}" Margin="0,7,0,20"/>
     <TextBlock Text="Projeto" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="Selecionar" Click="BrowseProjectClick" Margin="10,0,0,0"/><TextBox Text="{Binding ProjectPath,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeProject}" LostFocus="ProjectPathLostFocus" MinWidth="240"/></DockPanel>
     <TextBlock Text="{Binding LocalAgentLabel}" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="Localizar" Click="BrowseCodexClick" Margin="10,0,0,0"/><TextBox Text="{Binding AgentPath,UpdateSourceTrigger=PropertyChanged}" MinWidth="240"/></DockPanel><TextBlock Text="{Binding LocalAgentHint}" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
     <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Modelo" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding CanEditLocalSettings}" AutomationProperties.Name="Modelo da IA ativa"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Raciocínio" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Efforts}" SelectedItem="{Binding SelectedEffort}" IsEnabled="{Binding CanEditLocalSettings}" AutomationProperties.Name="Esforço de raciocínio"/></StackPanel></Grid>
     <TextBlock Text="{Binding ModelsDescription}" Style="{StaticResource Caption}" Margin="0,8,0,15"/>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,6,0,16"><StackPanel><TextBlock Text="Enquanto você dorme" FontWeight="SemiBold" FontSize="16"/><CheckBox Content="{Binding ReviewOptionLabel}" IsChecked="{Binding AutoReview}" IsEnabled="{Binding CanEditLocalSettings}"/><TextBlock Text="{Binding ReviewOptionHint}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="20"/><CheckBox Content="Manter o computador acordado durante o turno" IsChecked="{Binding PreventSleep}"/><TextBlock Text="A tela pode apagar. Ao parar, o Night Shift libera a suspensão normal." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="20"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><TextBlock Text="Duração máxima do turno" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding ShiftHours}" Width="70"/><TextBlock Text="horas" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
     <WrapPanel><Button Content="Salvar ajustes" Style="{StaticResource Primary}" Click="SaveClick" Margin="0,0,10,10"/><Button Content="{Binding LoginLabel}" Click="LoginClick" Margin="0,0,10,10" IsEnabled="{Binding CanUseCliSettings}"/><Button Content="Preparar sandbox Windows" Click="SandboxClick" Margin="0,0,10,10" IsEnabled="{Binding CanSetupSandbox}"/></WrapPanel>
     <TextBlock Text="{Binding SettingsConnectionHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,8"/><Button Content="Ajuda de instalação ↗" Style="{StaticResource Quiet}" Click="InstallHelpClick" HorizontalAlignment="Left" Padding="0,10"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="HistoryPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="Suas conversas" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding HistoryDescription}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Row="1" Margin="0,0,0,12"><WrapPanel><TextBox Text="{Binding HistorySearch,UpdateSourceTrigger=PropertyChanged}" Width="210" Margin="0,0,10,8" MaxLength="160" ToolTip="Buscar pelo título da conversa" AutomationProperties.Name="Buscar conversa"/><Button Content="Buscar / atualizar" Click="RefreshHistoryClick" IsEnabled="{Binding CanUseShortcuts}" Margin="0,0,10,8"/><Button Content="Retomar última do projeto" Click="ResumeLastClick" IsEnabled="{Binding CanResumeLast}" Margin="0,0,0,8"/></WrapPanel><CheckBox Content="Todos os projetos" IsChecked="{Binding AllProjects}" IsEnabled="{Binding CanUseShortcuts}"/><TextBlock Text="{Binding HistoryLabel}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,6"/></StackPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding Sessions}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="16" Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" Content="Retomar" Click="ResumeClick" Tag="{Binding}" IsEnabled="{Binding DataContext.CanUseShortcuts,RelativeSource={RelativeSource AncestorType=Window}}" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProjectPath}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,6,0,0" ToolTip="{Binding ProjectPath}"/><WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource Mint}" FontSize="13" Margin="0,0,12,0"/><TextBlock Text="{Binding DisplayDate}" Foreground="{DynamicResource Purple}" FontSize="13"/></WrapPanel></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="2" Text="Nenhuma conversa encontrada. Confira a pasta ou marque Todos os projetos." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Visibility="{Binding IsHistoryEmpty,Converter={StaticResource VisibleIf}}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"/>
     <Button Grid.Row="3" Content="Carregar mais conversas" Click="MoreHistoryClick" IsEnabled="{Binding CanLoadMoreHistory}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </Grid>
    <Grid x:Name="CommandsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,18"><TextBlock Text="Comandos, sem complicação." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Use os botões ou digite os atalhos na conversa. F1 abre esta tela." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding CommandCapabilityHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Commands}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" Content="Usar" Click="CommandClick" Tag="{Binding VisualCommand}" Margin="16,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CanExecute}"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Syntax}" Foreground="{DynamicResource Purple}" FontFamily="Consolas" FontSize="13" Margin="0,8,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>

    <ScrollViewer x:Name="IntegrationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="Conexão" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Plataforma" Style="{StaticResource Label}"/>
      <ComboBox ItemsSource="{Binding Platforms}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Platform}" IsEnabled="{Binding CanChangePlatform}" MinWidth="260" HorizontalAlignment="Left" Margin="0,0,0,18" AutomationProperties.Name="Plataforma" ToolTip="{Binding CompatibilityLabel}"/>
      <TextBlock Text="{Binding IntegrationDetails}" TextWrapping="Wrap" LineHeight="24" Foreground="{DynamicResource Muted}"/>
      <StackPanel Visibility="{Binding IsSharedPlatform,Converter={StaticResource VisibleIf}}">
       <TextBlock Text="{Binding SharedLimitations}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeInk}" LineHeight="23" Margin="0,16,0,12"/>
       <TextBlock Text="Opções de conexão" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8"/>
       <TextBlock Visibility="{Binding IsCodexProvider,Converter={StaticResource VisibleIf}}" Text="WebSocket local foi verificado com o Codex real. Socket local ainda não validado: o teste de conexão expirou. Campo vazio tenta o socket padrão." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
       <TextBox Visibility="{Binding IsCodexProvider,Converter={StaticResource VisibleIf}}" Text="{Binding SharedEndpoint,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangePlatform}" MinWidth="240" AutomationProperties.Name="Endereço do servidor compartilhado"/>
       <TextBlock Text="Exemplo: ws://127.0.0.1:4500. Use somente o servidor ao qual o aplicativo de origem já está conectado. Iniciar um servidor separado não conecta o Desktop ou o VS Code." TextWrapping="Wrap" Style="{StaticResource Caption}" LineHeight="22" Margin="0,10,0,18"/>
       <Button Content="Sessões ao vivo" Click="LivePageClick" HorizontalAlignment="Left" IsEnabled="{Binding IsConnected}"/>
      </StackPanel>
      <Button Content="{Binding ConnectLabel}" Click="ConnectClick" Style="{StaticResource Primary}" IsEnabled="{Binding CanConnect}" HorizontalAlignment="Left" Margin="0,22,0,14"/>
      <Button Content="Documentação oficial ↗" Style="{StaticResource Quiet}" Click="IntegrationHelpClick" HorizontalAlignment="Left" Padding="0,10"/>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="LivePage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Sessões ao vivo" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Abra a conversa no aplicativo de origem e atualize. Somente sessões carregadas neste servidor aparecem aqui." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,12"/>
      <WrapPanel><Button Content="Atualizar" Click="RefreshLiveClick" IsEnabled="{Binding CanRefreshLive}" Margin="0,0,16,0"/><CheckBox Content="Todos os projetos" IsChecked="{Binding AllProjects}" VerticalAlignment="Center"/></WrapPanel>
     </StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding LiveSessions}"><ListBox.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,16" Margin="0,0,0,8"><DockPanel>
       <Button DockPanel.Dock="Right" Content="Acompanhar" Click="ResumeClick" Tag="{Binding}" Margin="18,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding DataContext.CanRefreshLive,RelativeSource={RelativeSource AncestorType=Window}}"/>
       <StackPanel><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProjectPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding LiveLabel}" Foreground="{DynamicResource Mint}" FontSize="13" Margin="0,8,0,0"/><TextBlock Text="{Binding Originator,StringFormat=Origem registrada: {0}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
       </StackPanel>
      </DockPanel></Border>
     </DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="1" Text="Nenhuma sessão ao vivo neste servidor e filtro." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Visibility="{Binding IsLiveEmpty,Converter={StaticResource VisibleIf}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Grid x:Name="ActivityPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Atividade e limites" FontSize="24" FontWeight="SemiBold"/>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,8"><StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding FiveHourUsage}" Style="{StaticResource Caption}"/><TextBlock Text="5 horas" FontWeight="SemiBold"/></DockPanel><ProgressBar x:Name="ActivityFiveHourBar" Value="{Binding FiveHourUsed,Mode=OneWay}" Visibility="{Binding HasFiveHourLimit,Converter={StaticResource VisibleIf}}" Margin="0,10,0,8" Maximum="100"/><TextBlock Text="{Binding FiveHourReset}" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="16,0,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding WeeklyUsage}" Style="{StaticResource Caption}"/><TextBlock Text="Semanal" FontWeight="SemiBold"/></DockPanel><ProgressBar x:Name="ActivityWeeklyBar" Value="{Binding WeeklyUsed,Mode=OneWay}" Visibility="{Binding HasWeeklyLimit,Converter={StaticResource VisibleIf}}" Foreground="{DynamicResource Mint}" Margin="0,10,0,8" Maximum="100"/><TextBlock Text="{Binding WeeklyReset}" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
       </Grid><DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Atualizar" Click="RefreshLimitsClick" IsEnabled="{Binding CanRefreshLimits}" Style="{StaticResource Quiet}" Padding="9,5" FontSize="12"/><TextBlock Text="{Binding LimitsUpdateLabel}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
      </StackPanel></Border>
      <TextBlock Text="{Binding RetryLabel,StringFormat=Próxima verificação: {0}}" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
      <TextBlock Text="{Binding ShiftLabel,StringFormat=Turno: {0}}" Foreground="{DynamicResource Purple}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding ReviewLabel}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding SleepLabel}" Style="{StaticResource Caption}"/>
      <Button Content="Ativar retomada nesta conversa" Click="ArmShiftClick" IsEnabled="{Binding CanStartShift}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Activities}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
